# --- Ma'lumotlar bazasi (Supabase → Connect → Connection String; batafsil: docs/SETUP_UZ.md, 3-bo'lim) ---
# Production sozlamalari .env.production.local faylida turadi (npm run db:deploy:prod va boshqalar uchun).
DATABASE_URL=""        # Transaction pooler, port 6543, oxirida ?uselibpqcompat=true&sslmode=require
DIRECT_URL=""          # Session pooler, port 5432, oxirida ?sslmode=require (migratsiyalar va zaxira nusxa uchun)

# --- Sayt ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Navbat"
NEXT_PUBLIC_SUPPORT_TELEGRAM=""        # @ belgisiz, masalan: navbat_support

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""                  # @BotFather bergan token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""   # @ belgisiz, masalan: navbat_bot
TELEGRAM_WEBHOOK_SECRET=""             # tasodifiy, kamida 32 belgi (npm run secret)

# --- Xavfsizlik ---
SESSION_SECRET=""                      # tasodifiy, kamida 32 belgi (npm run secret)
CRON_SECRET=""                         # tasodifiy, kamida 32 belgi (npm run secret)
ADMIN_TELEGRAM_IDS=""                  # vergul bilan: 123456789,987654321 (botga /id yozib bilib olinadi)

# --- To'lov ko'rsatmasi (qo'lda to'lov davri) ---
PAYMENT_INSTRUCTIONS_UZ=""
PAYMENT_INSTRUCTIONS_RU=""

# --- Faqat lokal sinov uchun ---
REMINDER_TEST_MODE="false"
TEST_DATABASE_URL=""                   # ixtiyoriy: integratsiya testlari uchun ALOHIDA bo'sh baza (npm test)
