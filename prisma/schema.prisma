// Data model (spec 5.1). All timestamps are timestamptz in UTC.
// Connection URLs live in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uz
  ru
}

enum MemberRole {
  OWNER
  MANAGER
}

enum Category {
  BARBERSHOP
  BEAUTY_SALON
  NAILS
  COSMETOLOGY
  MASSAGE
  DENTAL
  CLINIC
  CAR_WASH
  AUTO_SERVICE
  TUTOR
  FITNESS
  PHOTO_STUDIO
  OTHER
}

enum Region {
  TASHKENT_CITY
  TASHKENT_REGION
  ANDIJAN
  BUKHARA
  FERGANA
  JIZZAKH
  KHOREZM
  NAMANGAN
  NAVOI
  KASHKADARYA
  SAMARKAND
  SYRDARYA
  SURKHANDARYA
  KARAKALPAKSTAN
}

enum PlanCode {
  TRIAL
  START
  PRO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED_BY_CLIENT
  CANCELLED_BY_BUSINESS
}

enum BookingSource {
  WEB
  TELEGRAM
  PANEL
}

enum LoginTokenStatus {
  PENDING
  CONFIRMED
  REJECTED
  USED
}

enum MessageType {
  REMINDER_24H
  REMINDER_2H
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Business owners and admins. Identified only via Telegram.
model User {
  id               String       @id @default(cuid())
  telegramId       BigInt       @unique
  telegramUsername String?
  firstName        String
  lastName         String?
  phone            String?
  locale           Locale       @default(uz)
  sessionVersion   Int          @default(1)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  memberships      Membership[]
}

model Membership {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  role       MemberRole @default(OWNER)
  notify     Boolean    @default(true) /// receive Telegram notifications
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model Business {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  category          Category
  region            Region
  district          String /// city or district, e.g. "Chilonzor tumani"
  address           String
  landmark          String? /// e.g. "Chilonzor metrosi yonida"
  mapUrl            String?
  latitude          Float?
  longitude         Float?
  phone             String /// +998XXXXXXXXX
  telegramUsername  String?
  instagram         String?
  description       String?
  logoUrl           String?
  timezone          String    @default("Asia/Tashkent")
  weeklySchedule    Json /// see src/lib/schedule.ts
  slotStepMinutes   Int       @default(30) /// 15 | 30 | 60
  minLeadMinutes    Int       @default(60)
  maxDaysAhead      Int       @default(30)
  autoConfirm       Boolean   @default(true)
  cancelUntilHours  Int       @default(2)
  reminder24h       Boolean   @default(true)
  reminder2h        Boolean   @default(true)
  isPublished       Boolean   @default(false)
  isBlocked         Boolean   @default(false)
  isDemo            Boolean   @default(false)
  plan              PlanCode  @default(TRIAL)
  trialEndsAt       DateTime  @db.Timestamptz(3)
  paidUntil         DateTime? @db.Timestamptz(3)
  featuredUntil     DateTime? @db.Timestamptz(3)
  referralCode      String    @unique
  referredById      String?
  /// Onboarding wizard step the owner is on (2..5); null once finished.
  onboardingStep    Int?
  /// Last subscription warning sent ("3d:<date>", "1d:<date>", "0d:<date>") to avoid duplicates.
  lastBillingNotice String?
  /// Owner pressed "I have paid" (shown to admins until the payment is recorded).
  paymentClaimedAt  DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  staff       Staff[]
  services    Service[]
  timeOffs    TimeOff[]
  clients     Client[]
  bookings    Booking[]
  payments    Payment[]

  @@index([region, category, isPublished])
}

model Staff {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  position       String?
  photoUrl       String?
  telegramId     BigInt?
  weeklySchedule Json? /// null → business schedule
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services       StaffService[]
  bookings       Booking[]
  timeOffs       TimeOff[]

  @@index([businessId])
}

model Service {
  id              String         @id @default(cuid())
  businessId      String
  nameUz          String
  nameRu          String?
  descriptionUz   String?
  descriptionRu   String?
  durationMinutes Int /// 5..480
  bufferMinutes   Int            @default(0)
  price           Int /// so'm, 0 = free
  priceIsFrom     Boolean        @default(false)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff           StaffService[]
  bookings        Booking[]

  @@index([businessId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

/// Days off, holidays, vacations. staffId null → the whole business is closed.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  staffId    String?
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
}

model Client {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String /// +998XXXXXXXXX
  telegramId BigInt?
  notes      String? /// visible to the business only
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@unique([businessId, phone])
  @@index([telegramId])
}

model Booking {
  id                  String             @id @default(cuid())
  businessId          String
  staffId             String
  serviceId           String
  clientId            String
  startsAt            DateTime           @db.Timestamptz(3)
  endsAt              DateTime           @db.Timestamptz(3)
  blockedUntil        DateTime           @db.Timestamptz(3) /// endsAt + buffer; used for overlap checks
  status              BookingStatus
  source              BookingSource
  serviceNameSnapshot String
  priceSnapshot       Int
  durationSnapshot    Int
  clientComment       String?
  internalNote        String?
  manageToken         String             @unique
  clientConfirmedAt   DateTime?          @db.Timestamptz(3)
  cancelledAt         DateTime?          @db.Timestamptz(3)
  cancelReason        String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff               Staff              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service             Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages            ScheduledMessage[]

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([clientId])
  @@index([status, startsAt])
}

/// Every Telegram user who has written to the bot at least once.
model TelegramChat {
  telegramId BigInt   @id
  firstName  String?
  username   String?
  locale     Locale   @default(uz)
  isBlocked  Boolean  @default(false) /// user blocked the bot (403)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model LoginToken {
  id          String           @id @default(cuid())
  token       String           @unique
  status      LoginTokenStatus @default(PENDING)
  telegramId  BigInt?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime         @db.Timestamptz(3)
  confirmedAt DateTime?        @db.Timestamptz(3)

  @@index([createdAt])
}

model ScheduledMessage {
  id        String        @id @default(cuid())
  bookingId String
  chatId    BigInt
  type      MessageType
  sendAt    DateTime      @db.Timestamptz(3)
  status    MessageStatus @default(PENDING)
  attempts  Int           @default(0)
  lastError String?
  sentAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([status, sendAt])
}

model Payment {
  id               String   @id @default(cuid())
  businessId       String
  amount           Int
  plan             PlanCode
  periodDays       Int      @default(30)
  method           String /// "click" | "payme" | "card" | "cash" | "other"
  note             String?
  recordedByUserId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @db.Timestamptz(3)

  @@index([windowStart])
}
